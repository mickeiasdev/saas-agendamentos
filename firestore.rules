rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA DO CLOUD FIRESTORE
// Isolamento multi-tenant obrigatório.
// Um usuário só pode ler/gravar documentos do tenant ao qual pertence.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- USUÁRIOS ----------
    // Cada usuário lê/edita o próprio perfil.
    // platformRole NÃO pode ser elevado no cliente (somente Admin SDK).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (!('platformRole' in request.resource.data)
            || request.resource.data.platformRole == 'USER');
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.platformRole == resource.data.platformRole;
      allow delete: if false;
    }

    // ---------- MEMBROS (tenant_users) ----------
    // Leitura permitida para o próprio usuário (para listar seus tenants).
    // Create no cliente: somente o dono, no onboarding (TENANT_OWNER).
    // Convites de outros papéis passam pela API (Admin SDK).
    match /tenant_users/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.role in ['TENANT_OWNER']
        && request.resource.data.status == 'active'
        && id == request.auth.uid + '_' + request.resource.data.tenantId;
      allow update, delete: if false;
    }

    // ---------- CONVITES ----------
    // Somente Admin SDK (API de convite / aceite). Cliente não lê nem grava.
    match /invites/{token} {
      allow read, write: if false;
    }

    // ---------- PLATAFORMA (bootstrap do PLATFORM_OWNER) ----------
    match /platform/{docId} {
      allow read, write: if false;
    }

    // ---------- SLUGS (endereço público único) ----------
    // Documento slugs/{slug} é a trava de unicidade. Create-only.
    match /slugs/{slug} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && slug.size() >= 2
        && slug.size() <= 48
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId.size() > 0;
      allow update, delete: if false;
    }

    // ---------- TENANTS ----------
    // O documento do tenant contém dados sensíveis (cnpjCpf, ownerUserId,
    // planId, settings, limits). Portanto, ele NÃO é de leitura pública.
    // O site público consome dados sanitizados via API route (Admin SDK).
    // Escrita apenas por membros do tenant / papel de plataforma.
    match /tenants/{tenantId} {
      function isMember() {
        return isTenantMember(tenantId);
      }

      function hasRole(roles) {
        return isMember() && getTenantRole(tenantId).role in roles;
      }

      allow read: if request.auth != null && (isMember() || isPlatformRole());
      allow create: if request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 2;
      allow update: if request.auth != null
        && hasRole(['TENANT_OWNER', 'TENANT_ADMIN'])
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.status == resource.data.status
        && request.resource.data.planId == resource.data.planId;
      allow delete: if request.auth != null && isPlatformRole();

      match /categories/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER']);
      }

      match /services/{docId} {
        // Catálogo servido ao site público via API route (Admin SDK).
        // No Firestore, somente membros do tenant acessam.
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER']);
      }

      match /professionals/{docId} {
        // Catálogo servido ao site público via API route (Admin SDK).
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER']);
      }

      match /availability/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER']);
      }

      match /holidays/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER']);
      }

      match /customers/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER']);
      }

      // Agendamentos: agendamentos do site público são criados pelo backend
      // (API route com Admin SDK, que valida disponibilidade e double booking).
      // Clientes não autenticados NÃO escrevem diretamente no Firestore.
      // Membros do tenant (exceto CUSTOMER) podem criar manualmente.
      match /appointments/{docId} {
        allow read: if isMember();
        allow create: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN', 'MANAGER', 'PROFESSIONAL']);
        allow update: if isMember();
        allow delete: if false;
      }

      match /payments/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
      }

      match /coupons/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
      }

      match /promotions/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
      }

      match /loyalty_rewards/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
      }

      match /loyalty_accounts/{docId} {
        allow read: if isMember();
        allow create: if isMember();
        allow update: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
        allow delete: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
      }

      match /loyalty_transactions/{docId} {
        allow read: if isMember();
        allow create: if isMember();
        allow update: if false;
        allow delete: if false;
      }

      match /financial/{docId} {
        allow read: if isMember();
        allow write: if isMember() && hasRole(['TENANT_OWNER', 'TENANT_ADMIN']);
      }

      match /reviews/{docId} {
        // Avaliações criadas por clientes do site público passam pela API route
        // (Admin SDK), que valida o atendimento e a identidade antes de gravar.
        // Aqui, somente membros do tenant escrevem diretamente.
        allow read: if isMember();
        allow create: if isMember();
        allow update: if isMember();
        allow delete: if isMember();
      }

      match /notifications/{docId} {
        allow read: if isMember();
        allow create: if isMember();
        allow update: if isMember();
        allow delete: if false;
      }

      match /audit/{docId} {
        allow read: if isMember() && hasRole(['TENANT_OWNER', 'PLATFORM_OWNER']);
        allow create: if isMember();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================
    function isPlatformRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole in ['PLATFORM_OWNER', 'PLATFORM_ADMIN'];
    }

    function isTenantMember(tenantId) {
      return exists(/databases/$(database)/documents/tenant_users/$(request.auth.uid + '_' + tenantId))
        && getTenantRole(tenantId).status == 'active';
    }

    function getTenantRole(tid) {
      return get(/databases/$(database)/documents/tenant_users/$(request.auth.uid + '_' + tid)).data;
    }
  }
}
