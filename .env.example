# ============================================================
# NEXT_PUBLIC_* variables are exposed to the browser (client SDK)
# NEVER put real secrets here. This file is the template.
# Copy to .env.local and fill with YOUR Firebase project values.
# ============================================================

# --- Firebase Web (client) config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, e.g. API routes) ---
# Option A: full service account JSON (single line or escaped).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: individual fields (used by src/lib/server/firebaseAdmin.ts
# when FIREBASE_SERVICE_ACCOUNT_JSON is empty).
# FIREBASE_PRIVATE_KEY must keep the \n sequences from the JSON key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Platform identity ---
# Subdomain used for the public site of each tenant
# Local/preview: /{slug}   Production: {slug}.minhaplataforma.com
NEXT_PUBLIC_PLATFORM_DOMAIN=minhaplataforma.com
