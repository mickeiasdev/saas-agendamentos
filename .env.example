# ============================================================
# NEXT_PUBLIC_* variables are exposed to the browser (client SDK)
# NEVER put real secrets here. This file is the template.
# Copy to .env.local and fill with YOUR Firebase project values.
# ============================================================

# --- Firebase Web (client) config ---
# API key do Firebase é pública por design (segurança = Security Rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional. Fotos NÃO usam Cloud Storage (plano pago / ativação extra).
# Imagens são comprimidas no browser e gravadas no Firestore como data URL.
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase Admin SDK (server-only, e.g. API routes) ---
# Option A: JSON na raiz (recomendado neste projeto experimental).
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json

# Option B: full service account JSON (single line or escaped).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C: individual fields.
# FIREBASE_PRIVATE_KEY must keep the \n sequences from the JSON key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Platform identity ---
# Subdomain used for the public site of each tenant
# Local/preview: /{slug}   Production: {slug}.minhaplataforma.com
NEXT_PUBLIC_PLATFORM_DOMAIN=minhaplataforma.com
